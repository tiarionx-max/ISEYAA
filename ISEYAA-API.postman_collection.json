{
  "info": {
    "name": "ISEYAA Super Platform API",
    "description": "Complete API collection for ISEYAA — Ogun State Government Super-Platform.\n\n**Setup:**\n1. Set `baseUrl` variable to `https://iseyaabackend-production.up.railway.app/api/v1`\n2. Run **Auth → Send OTP** then **Auth → Phone Auth** — tokens are saved automatically\n3. All authenticated requests use `{{accessToken}}` automatically",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://iseyaabackend-production.up.railway.app/api/v1", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "testPhone", "value": "+2348012345678", "type": "string" },
    { "key": "testOtp", "value": "123456", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "eventId", "value": "", "type": "string" },
    { "key": "propertyId", "value": "", "type": "string" },
    { "key": "tripId", "value": "", "type": "string" },
    { "key": "orderId", "value": "", "type": "string" },
    { "key": "lgaId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [

    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST", "auth": { "type": "noauth" },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"test@example.com\",\n  \"phone\": \"{{testPhone}}\",\n  \"password\": \"Password123!\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"ndpaConsent\": true\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const d = pm.response.json();", "if (d.accessToken) {", "  pm.collectionVariables.set('accessToken', d.accessToken);", "  pm.collectionVariables.set('refreshToken', d.refreshToken);", "  pm.collectionVariables.set('userId', d.user?.id ?? '');", "}"] } }]
        },
        {
          "name": "Login (email/phone + password)",
          "request": {
            "method": "POST", "auth": { "type": "noauth" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{testPhone}}\",\n  \"password\": \"Password123!\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const d = pm.response.json();", "if (d.accessToken) {", "  pm.collectionVariables.set('accessToken', d.accessToken);", "  pm.collectionVariables.set('refreshToken', d.refreshToken);", "  pm.collectionVariables.set('userId', d.user?.id ?? '');", "}"] } }]
        },
        {
          "name": "OTP — Send",
          "request": {
            "method": "POST", "auth": { "type": "noauth" },
            "url": { "raw": "{{baseUrl}}/auth/otp/send", "host": ["{{baseUrl}}"], "path": ["auth","otp","send"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"{{testPhone}}\"\n}" }
          }
        },
        {
          "name": "OTP — Phone Auth (verify + auto login/register)",
          "request": {
            "method": "POST", "auth": { "type": "noauth" },
            "url": { "raw": "{{baseUrl}}/auth/phone-auth", "host": ["{{baseUrl}}"], "path": ["auth","phone-auth"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"{{testPhone}}\",\n  \"otp\": \"{{testOtp}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const d = pm.response.json();", "if (d.accessToken) {", "  pm.collectionVariables.set('accessToken', d.accessToken);", "  pm.collectionVariables.set('refreshToken', d.refreshToken);", "  pm.collectionVariables.set('userId', d.user?.id ?? '');", "  console.log('✅ Tokens saved. isNewUser:', d.isNewUser);", "}"] } }]
        },
        {
          "name": "OTP — Verify only",
          "request": {
            "method": "POST", "auth": { "type": "noauth" },
            "url": { "raw": "{{baseUrl}}/auth/otp/verify", "host": ["{{baseUrl}}"], "path": ["auth","otp","verify"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"{{testPhone}}\",\n  \"otp\": \"{{testOtp}}\"\n}" }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST", "auth": { "type": "noauth" },
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth","refresh"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const d = pm.response.json();", "if (d.accessToken) {", "  pm.collectionVariables.set('accessToken', d.accessToken);", "  pm.collectionVariables.set('refreshToken', d.refreshToken);", "}"] } }]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth","logout"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          }
        }
      ]
    },

    {
      "name": "👤 Users",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users","me"] }
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users","me"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Damilola\",\n  \"lastName\": \"Fajorin\",\n  \"avatarUrl\": \"\",\n  \"lgaId\": \"{{lgaId}}\"\n}" }
