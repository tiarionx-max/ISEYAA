        {
          "name": "KYC — Submit BVN",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/users/kyc/bvn", "host": ["{{baseUrl}}"], "path": ["users","kyc","bvn"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"bvn\": \"12345678901\"\n}" }
          }
        },
        {
          "name": "KYC — Submit NIN",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/users/kyc/nin", "host": ["{{baseUrl}}"], "path": ["users","kyc","nin"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nin\": \"12345678901\"\n}" }
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users","{{userId}}"] }
          }
        },
        {
          "name": "Delete My Data (NDPA erasure)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/users/me/data", "host": ["{{baseUrl}}"], "path": ["users","me","data"] }
          }
        }
      ]
    },

