{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true
  },
  "projects": {
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "src/main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.app.json"
      }
    },
    "wallet-service": {
      "type": "application",
      "root": "apps/wallet-service",
      "entryFile": "src/main",
      "sourceRoot": "apps/wallet-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/wallet-service/tsconfig.app.json"
      }
    },
    "events-service": {
      "type": "application",
      "root": "apps/events-service",
      "entryFile": "src/main",
      "sourceRoot": "apps/events-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/events-service/tsconfig.app.json"
      }
    },
    "stays-service": {
      "type": "application",
      "root": "apps/stays-service",
      "entryFile": "src/main",
      "sourceRoot": "apps/stays-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/stays-service/tsconfig.app.json"
      }
    },
    "marketplace-service": {
      "type": "application",
      "root": "apps/marketplace-service",
      "entryFile": "src/main",
      "sourceRoot": "apps/marketplace-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/marketplace-service/tsconfig.app.json"
      }
    },
    "admin-service": {
      "type": "application",
      "root": "apps/admin-service",
      "entryFile": "src/main",
      "sourceRoot": "apps/admin-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/admin-service/tsconfig.app.json"
      }
    },
    "ai-service": {
      "type": "application",
      "root": "apps/ai-service",
      "entryFile": "src/main",
      "sourceRoot": "apps/ai-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ai-service/tsconfig.app.json"
      }
    },
    "notifications-service": {
      "type": "application",
      "root": "apps/notifications-service",
      "entryFile": "src/main",
      "sourceRoot": "apps/notifications-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notifications-service/tsconfig.app.json"
      }
    }
  }
}
