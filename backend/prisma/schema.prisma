generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  CITIZEN
  TOURIST
  VENDOR
  ORGANISER
  HOST
  DRIVER
  CREATIVE
  LGA_ADMIN
  STATE_ADMIN
  SUPER_ADMIN
  TOUR_GUIDE // Phase 9 — additively appended via PG ALTER TYPE ADD VALUE
  MINISTRY_VIEWER // Phase 14 — additively appended via PG ALTER TYPE ADD VALUE
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum KYCStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum OtpChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum AttractionCategory {
  NATURAL
  CULTURAL
  HISTORICAL
  RECREATIONAL
  RELIGIOUS
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum TicketStatus {
  PENDING
  ISSUED
  PAID
  USED
  CANCELLED
  REFUNDED
}

enum PropertyType {
  HOTEL
  GUESTHOUSE
  APARTMENT
  VILLA
  RESORT
  LOUNGE
  CLUB
  BEACH
  TOUR
  EXPERIENCE
  ATTRACTION
}

enum BookingMode {
  NIGHTLY // stays — pricePerNight × nights
  HOURLY // lounges / studio-like / club table — pricePerHour × hours
  TIMED_EVENT // tour, attraction visit — fixed price × people, fixed start
  MEMBERSHIP // social club — monthly / yearly subscription
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  REFUNDED
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum StudioType {
  RECORDING
  PHOTOGRAPHY
  VIDEO
  PODCAST
}

enum StudioBookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum TransactionType {
  CREDIT
  DEBIT
  REFUND
  TRANSFER
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum PaymentGateway {
  PAYSTACK
  FLUTTERWAVE
  WALLET
  INTERNAL
}

enum VehicleType {
  BIKE
  TRICYCLE
  CAR
  MINIBUS
}

enum DriverStatus {
  PENDING_REVIEW
  APPROVED
  SUSPENDED
  REJECTED
}

enum TripStatus {
  SEARCHING
  MATCHED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum DeliveryOrderStatus {
  SEARCHING
  MATCHED
  COLLECTING
  IN_TRANSIT
  DELIVERED
  CANCELLED
  EXPIRED
}

// ─── Phase 9: Tour Packages & Tour Guides enums ──────────────────────────────

enum TourPackageCategory {
  HERITAGE
  CULTURAL
  ADIRE
  FESTIVAL
  FOOD
  FAMILY
  FAITH
  SCHOOL
  CORPORATE
}

enum TourPackageStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum TourGuideStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewTargetType {
  GUIDE
  PACKAGE
  VENUE
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                    String     @id @default(uuid())
  email                 String?    @unique
  phone                 String?    @unique
  passwordHash          String?
  firstName             String
  lastName              String
  role                  UserRole   @default(CITIZEN)
  registeredRoles       UserRole[]
  status                UserStatus @default(PENDING)
  kycStatus             KYCStatus  @default(NONE)
  otpChannel            OtpChannel @default(SMS)
  lgaId                 String?
  lga                   LGA?       @relation(fields: [lgaId], references: [id])
  avatarUrl             String?
  nin                   String?    @unique
  bvn                   String?    @unique
  bvnHash               String? // bcrypt hash of BVN for duplicate lookup
  ninHash               String? // bcrypt hash of NIN for duplicate lookup
  kycBvnVerifiedAt      DateTime?
  kycNinVerifiedAt      DateTime?
  kycLivenessVerifiedAt DateTime?
  ndpaConsent           Boolean    @default(false)
  ndpaConsentAt         DateTime?
  metadata              Json?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  deletedAt             DateTime?

  wallet               Wallet?
  tickets              Ticket[]
  bookings             Booking[]
  orders               Order[]
  studioBookings       StudioBooking[]
  mediaContents        MediaContent[]
  auditLogs            AuditLog[]
  attractionBookmarks  AttractionBookmark[]
  driverProfile        Driver?
  riderTrips           Trip[]               @relation("RiderTrips")
  deliveryRiderProfile DeliveryRider?
  senderOrders         DeliveryOrder[]      @relation("SenderOrders")
  tourGuide            TourGuide?
  tourBookings         TourBooking[]        @relation("TourBuyer")
  reviews              Review[]
  settlementDisputesRaised SettlementDispute[]

  @@index([deletedAt])
  @@index([status])
  @@map("users")
}

model LGA {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  stateCode   String    @default("OG")
  description String?
  imageUrl    String?
  latitude    Decimal?
  longitude   Decimal?
  isActive    Boolean   @default(true)
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users        User[]
  attractions  Attraction[]
  events       Event[]
  properties   Property[]
  vendors      Vendor[]
  tourPackages TourPackage[]
  visitorLogs  VisitorLog[]

  @@map("lgas")
}

enum VisitorSourceType {
  EVENT
  STAY
  TOUR
}

model VisitorLog {
  id         String            @id @default(uuid())
  lgaId      String?
  lga        LGA?              @relation(fields: [lgaId], references: [id])
  purpose    String // free-text taxonomy value (D-05) — not an enum, per "not hardcoded" decision
  sourceType VisitorSourceType
  sourceId   String // Ticket.id | Booking.id | TourBooking.id — polymorphic, no FK enforced
  visitedAt  DateTime
  userRole   UserRole
  createdAt  DateTime          @default(now())

  @@index([lgaId])
  @@index([visitedAt])
  @@index([sourceType, sourceId])
  @@map("visitor_logs")
}

model Attraction {
  id          String             @id @default(uuid())
  lgaId       String
  lga         LGA                @relation(fields: [lgaId], references: [id])
  name        String
  slug        String             @unique
  description String?
  category    AttractionCategory
  imageUrls   String[]
  latitude    Decimal?
  longitude   Decimal?
  address     String?
  entryFee    Decimal?           @default(0)
  isActive    Boolean            @default(true)
  metadata    Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  bookmarks AttractionBookmark[]

  @@map("attractions")
}

model Event {
  id          String      @id @default(uuid())
  lgaId       String
  lga         LGA         @relation(fields: [lgaId], references: [id])
  organizerId String
  title       String
  slug        String      @unique
  description String?
  imageUrls   String[]
  venue       String
  address     String?
  latitude    Decimal?
  longitude   Decimal?
  startDate   DateTime
  endDate     DateTime
  status      EventStatus @default(DRAFT)
  isFeatured  Boolean     @default(false)
  metadata    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  ticketTypes TicketType[]

  @@map("events")
}

model TicketType {
  id          String    @id @default(uuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id])
  name        String
  description String?
  price       Decimal
  quantity    Int
  sold        Int       @default(0)
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tickets Ticket[]

  @@map("ticket_types")
}

model Ticket {
  id           String       @id @default(uuid())
  ticketTypeId String
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id])
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  qrCode       String       @unique
  paystackRef  String?      @unique
  qrImageUrl   String?
  status       TicketStatus @default(PENDING)
  usedAt       DateTime?
  metadata     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  @@index([userId])
  @@index([ticketTypeId])
  @@map("tickets")
}

model Property {
  id                     String       @id @default(uuid())
  lgaId                  String
  lga                    LGA          @relation(fields: [lgaId], references: [id])
  hostId                 String?
  vendorId               String?
  vendor                 Vendor?      @relation(fields: [vendorId], references: [id])
  name                   String
  slug                   String       @unique
  description            String?
  type                   PropertyType
  bookingMode            BookingMode  @default(NIGHTLY)
  category               String? // free-form sub-category, e.g. "rooftop_lounge", "afrobeats_club"
  imageUrls              String[]
  coverImageUrl          String? // hero photo for category cards
  address                String
  latitude               Decimal?
  longitude              Decimal?
  pricePerNight          Decimal // primary price; meaning depends on bookingMode
  pricePerHour           Decimal? // for HOURLY (lounges, club tables)
  membershipMonthlyPrice Decimal? // for MEMBERSHIP (social clubs)
  membershipBenefits     String[] // bullet points for memberships
  maxGuests              Int
  amenities              String[]
  highlights             String[] // 3-5 key selling points shown on detail page
  rating                 Decimal? // average review rating, populated by webhook/cron
  reviewCount            Int          @default(0)
  isActive               Boolean      @default(true)
  isFeatured             Boolean      @default(false)
  metadata               Json?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  deletedAt              DateTime?

  bookings Booking[]

  @@index([type, isActive])
  @@index([bookingMode])
  @@map("properties")
}

model Booking {
  id               String        @id @default(uuid())
  propertyId       String
  property         Property      @relation(fields: [propertyId], references: [id])
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  checkIn          DateTime
  checkOut         DateTime
  guests           Int
  totalPrice       Decimal
  govtLevyPct      Decimal       @default(0.05)
  status           BookingStatus @default(PENDING)
  paystackRef      String?       @unique
  escrowReleasedAt DateTime?
  reviewRating     Int?
  reviewComment    String?
  reviewedAt       DateTime?
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  @@index([propertyId, status, escrowReleasedAt])
  @@index([userId])
  @@map("bookings")
}

model Vendor {
  id             String       @id @default(uuid())
  userId         String       @unique
  lgaId          String
  lga            LGA          @relation(fields: [lgaId], references: [id])
  businessName   String
  slug           String       @unique
  description    String?
  logoUrl        String?
  status         VendorStatus @default(PENDING)
  commissionRate Decimal      @default(10)
  govtLevyPct    Decimal      @default(0)
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  products   Product[]
  properties Property[]

  @@map("vendors")
}

model Product {
  id             String    @id @default(uuid())
  vendorId       String
  vendor         Vendor    @relation(fields: [vendorId], references: [id])
  name           String
  slug           String    @unique
  description    String?
  imageUrls      String[]
  price          Decimal
  compareAtPrice Decimal? // "was ₦X" — for sale strikethrough
  category       String? // 'fashion' | 'crafts' | 'food' | 'art' | 'tech' | 'agriculture'
  stock          Int       @default(0)
  rating         Decimal?
  reviewCount    Int       @default(0)
  isActive       Boolean   @default(true)
  isFeatured     Boolean   @default(false)
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  orderItems OrderItem[]

  @@map("products")
}

model Order {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  vendorId     String?
  totalAmount  Decimal
  platformFee  Decimal?
  govtLevy     Decimal?
  vendorPayout Decimal?
  paystackRef  String?     @unique
  status       OrderStatus @default(PENDING)
  metadata     Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  orderItems OrderItem[]

  @@index([userId])
  @@index([vendorId])
  @@map("orders")
}

model OrderItem {
  id        String    @id @default(uuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id])
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal
  subtotal  Decimal
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model StudioSlot {
  id                   String     @id @default(uuid())
  name                 String
  type                 StudioType
  description          String?
  imageUrls            String[]
  pricePerHour         Decimal
  durationMinutes      Int        @default(60)
  capacity             Int        @default(1)
  isActive             Boolean    @default(true)
  isGovernmentPriority Boolean    @default(false)
  metadata             Json?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  deletedAt            DateTime?

  bookings StudioBooking[]

  @@map("studio_slots")
}

model StudioBooking {
  id           String              @id @default(uuid())
  studioSlotId String
  studioSlot   StudioSlot          @relation(fields: [studioSlotId], references: [id])
  userId       String
  user         User                @relation(fields: [userId], references: [id])
  startTime    DateTime
  endTime      DateTime
  totalPrice   Decimal
  paystackRef  String?             @unique
  status       StudioBookingStatus @default(PENDING)
  metadata     Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?

  @@map("studio_bookings")
}

model MediaContent {
  id           String    @id @default(uuid())
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  s3Key        String
  type         MediaType
  title        String?
  description  String?
  isPublished  Boolean   @default(false)
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@map("media_contents")
}

model Wallet {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id])
  balance   Decimal   @default(0)
  currency  String    @default("NGN")
  isActive  Boolean   @default(true)
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id            String            @id @default(uuid())
  walletId      String
  wallet        Wallet            @relation(fields: [walletId], references: [id])
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  amount        Decimal
  currency      String            @default("NGN")
  reference     String            @unique
  gateway       PaymentGateway
  gatewayRef    String?
  description   String?
  balanceBefore Decimal
  balanceAfter  Decimal
  metadata      Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  @@index([walletId])
  @@map("transactions")
}

model PlatformConfig {
  id        String    @id @default(uuid())
  key       String    @unique
  value     Json
  isPublic  Boolean   @default(false)
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("platform_configs")
}

model SettlementSplitTier {
  id            String    @id @default(uuid())
  module        String
  tierName      String    @default("default")
  minAmountNgn  Decimal?
  maxAmountNgn  Decimal?
  earnerPct     Decimal
  ministryPct   Decimal
  platformPct   Decimal?
  isActive      Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // No @@unique([module, tierName]) here — a module/tierName pair legitimately
  // repeats across historical (isActive: false) rows once updateSplitTier()'s
  // insert-new-row/deactivate-old audit trail (D-05) has run once. Uniqueness
  // is enforced only among ACTIVE rows via a partial index added by raw SQL
  // in the migration (Postgres/Prisma can't express a partial unique index
  // as a `@@unique` schema attribute).
  @@index([module, tierName])
  @@index([module, isActive])
  @@map("settlement_split_tiers")
}

enum ExportCadence {
  WEEKLY
  MONTHLY
  QUARTERLY
}

enum ExportDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

model MinistryExportSubscription {
  id          String               @id @default(uuid())
  recipients  String[] // D-11: free-text emails, not FK to User
  cadence     ExportCadence
  isActive    Boolean              @default(true)
  lastSentAt  DateTime? // D-04: rolling-window anchor; null until first successful send
  lastStatus  ExportDeliveryStatus @default(PENDING)
  lastError   String? // D-12; truncated to <=500 chars before persisting (22-03)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([isActive])
  @@map("ministry_export_subscriptions")
}

model ShadowSettlementComparison {
  id              String   @id @default(uuid())
  module          String // 'transport' | 'delivery'
  sourceId        String // Trip.id or DeliveryOrder.id this comparison is for
  oldEarnerAmount Decimal
  newEarnerAmount Decimal
  matched         Boolean
  comparedAt      DateTime @default(now())

  @@index([module, comparedAt])
  @@index([module, matched])
  @@map("shadow_settlement_comparisons")
}

model AuditLog {
  id        String    @id @default(uuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AttractionBookmark {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  attractionId String
  attraction   Attraction @relation(fields: [attractionId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([userId, attractionId])
  @@map("attraction_bookmarks")
}

model Driver {
  id             String       @id @default(uuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id])
  licenceNumber  String
  licenceExpiry  DateTime
  status         DriverStatus @default(PENDING_REVIEW)
  approvedById   String?
  approvedAt     DateTime?
  isOnline       Boolean      @default(false)
  lastSeenAt     DateTime?
  avgRating      Decimal      @default(0)
  totalTrips     Int          @default(0)
  acceptanceRate Decimal      @default(0)
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  vehicles      Vehicle[]
  tripsAsDriver Trip[]    @relation("DriverTrips")

  @@map("drivers")
}

model Vehicle {
  id          String      @id @default(uuid())
  driverId    String
  driver      Driver      @relation(fields: [driverId], references: [id])
  type        VehicleType
  make        String
  model       String
  year        Int
  plateNumber String      @unique
  colour      String
  imageUrl    String?
  isActive    Boolean     @default(true)
  metadata    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  trips Trip[]

  @@map("vehicles")
}

model Trip {
  id              String      @id @default(uuid())
  riderId         String
  rider           User        @relation("RiderTrips", fields: [riderId], references: [id])
  driverId        String?
  driver          Driver?     @relation("DriverTrips", fields: [driverId], references: [id])
  vehicleId       String?
  vehicle         Vehicle?    @relation(fields: [vehicleId], references: [id])
  vehicleType     VehicleType
  pickupLat       Decimal
  pickupLng       Decimal
  pickupAddress   String?
  dropoffLat      Decimal
  dropoffLng      Decimal
  dropoffAddress  String?
  distanceKm      Decimal?
  fare            Decimal?
  surgeMultiplier Decimal     @default(1)
  platformFee     Decimal?
  driverEarnings  Decimal?
  status          TripStatus  @default(SEARCHING)
  requestedAt     DateTime    @default(now())
  matchedAt       DateTime?
  arrivedAt       DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  riderRating     Int?
  driverRating    Int?
  cancelReason    String?
  metadata        Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  events TripEvent[]

  @@index([status, requestedAt])
  @@index([driverId, status])
  @@index([riderId])
  @@map("trips")
}

model TripEvent {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  event     String
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("trip_events")
}

model DeliveryRider {
  id              String       @id @default(uuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id])
  status          DriverStatus @default(PENDING_REVIEW)
  approvedById    String?
  approvedAt      DateTime?
  isOnline        Boolean      @default(false)
  lastSeenAt      DateTime?
  avgRating       Decimal      @default(0)
  totalDeliveries Int          @default(0)
  acceptanceRate  Decimal      @default(0)
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  orders DeliveryOrder[] @relation("RiderOrders")

  @@map("delivery_riders")
}

model DeliveryOrder {
  id              String              @id @default(uuid())
  senderId        String
  sender          User                @relation("SenderOrders", fields: [senderId], references: [id])
  riderId         String?
  rider           DeliveryRider?      @relation("RiderOrders", fields: [riderId], references: [id])
  pickupAddress   String
  pickupLat       Decimal
  pickupLng       Decimal
  dropoffAddress  String
  dropoffLat      Decimal
  dropoffLng      Decimal
  itemDescription String
  weightKg        Decimal
  recipientPhone  String
  fee             Decimal?
  platformFee     Decimal?
  riderEarnings   Decimal?
  status          DeliveryOrderStatus @default(SEARCHING)
  proofPhotoUrl   String?
  otpVerifiedAt   DateTime?
  requestedAt     DateTime            @default(now())
  matchedAt       DateTime?
  collectedAt     DateTime?
  completedAt     DateTime?
  cancelReason    String?
  senderRating    Int?
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  events DeliveryEvent[]

  @@index([status, createdAt])
  @@index([riderId, status])
  @@map("delivery_orders")
}

model DeliveryEvent {
  id        String        @id @default(uuid())
  orderId   String
  order     DeliveryOrder @relation(fields: [orderId], references: [id])
  event     String
  metadata  Json?
  createdAt DateTime      @default(now())

  @@map("delivery_events")
}

model WaitlistEntry {
  id        String   @id @default(uuid())
  email     String?
  phone     String?
  fullName  String?
  source    String // 'marketplace_web' | 'marketplace_mobile' | future channels
  metadata  Json?
  createdAt DateTime @default(now())

  @@unique([source, email])
  @@unique([source, phone])
  @@index([source, createdAt])
  @@map("waitlist_entries")
}

model NewsItem {
  id          String    @id @default(uuid())
  headline    String
  summary     String?
  link        String? // external URL or internal route
  source      String? // "Ogun State Gov", "BBC Pidgin", "Iṣẹ́yáá Desk", etc.
  category    String? // 'gov' | 'tourism' | 'business' | 'culture' | 'sport'
  imageUrl    String?
  publishedAt DateTime  @default(now())
  isLive      Boolean   @default(true)
  isPriority  Boolean   @default(false)
  metadata    Json?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([isLive, publishedAt])
  @@map("news_items")
}

// ─── Phase 9: Tour Packages & Tour Guides models ─────────────────────────────

model TourGuide {
  id              String          @id @default(uuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id])
  bio             String?
  yearsExperience Int             @default(0)
  languagesSpoken String[]
  certifications  String[] // S3 URLs of uploaded certificates
  ninCiphertext   String? // AES-256-GCM ciphertext (EncryptionService — Phase 5)
  ninHash         String? // bcrypt hash for duplicate lookup (mirrors users.ninHash)
  kycTier         Int             @default(0)
  availability    Json? // { blockedDates: string[] (ISO YYYY-MM-DD), weeklyOffDays: number[] (0-6 UTC) }
  status          TourGuideStatus @default(PENDING)
  rating          Decimal?
  reviewCount     Int             @default(0)
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  packages TourPackage[]

  @@index([status])
  @@map("tour_guides")
}

model TourPackage {
  id                String              @id @default(uuid())
  slug              String              @unique
  // NOTE: lgaId + tourGuideId are NULLABLE to support AI-suggestion DRAFT shape
  // from 09-04's POST /tour-packages/from-ai-suggestion. Service-layer guard
  // (09-04) enforces both populated before status can move past DRAFT.
  lgaId             String?
  lga               LGA?                @relation(fields: [lgaId], references: [id])
  tourGuideId       String?
  tourGuide         TourGuide?          @relation(fields: [tourGuideId], references: [id])
  name              String
  description       String?
  category          TourPackageCategory
  price             Decimal // NGN, per passenger before bulk discount
  durationHours     Int
  maxGroupSize      Int                 @default(50)
  coverImageUrl     String?
  imageUrls         String[]
  attractionIds     String[] // 1+ required (service-layer guard)
  propertyId        String? // optional FK to Property (no FK enforced — service-layer guard)
  eventIds          String[] // optional, multi
  transportNote     String? // optional, no FK
  itineraryTemplate Json // [{ hour: int, title: string, description: string, location?: string }]
  settlementSplit   Json // [{ vendorType: 'GUIDE'|'HOST'|'ORGANISER'|'ATTRACTION', vendorId: string, percentage: number }]
  rating            Decimal?
  reviewCount       Int                 @default(0)
  status            TourPackageStatus   @default(DRAFT)
  isFeatured        Boolean             @default(false)
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  bookings TourBooking[]

  @@index([status, category])
  @@index([tourGuideId])
  @@index([lgaId])
  @@map("tour_packages")
}

model TourBooking {
  id                   String        @id @default(uuid())
  reference            String        @unique // ISY-TOUR-<12char> — generator lives in 09-02
  tourPackageId        String
  tourPackage          TourPackage   @relation(fields: [tourPackageId], references: [id])
  buyerUserId          String
  buyer                User          @relation("TourBuyer", fields: [buyerUserId], references: [id])
  groupLeaderUserId    String?
  tourDate             DateTime      @db.Date
  passengerCount       Int
  passengers           Json? // [{ name: string, phone: string }] for groups
  unitPrice            Decimal // per passenger after any bulk discount applied
  totalAmount          Decimal // unitPrice × passengerCount (or sum of paid shares for split-bill)
  paymentReference     String? // Paystack reference (may differ from `reference` for split-bill child charges)
  status               BookingStatus @default(PENDING) // REUSE existing BookingStatus enum — see 09-01-PLAN must_haves
  itineraryId          String?       @unique // materialized at booking time
  itinerary            Itinerary?    @relation(fields: [itineraryId], references: [id])
  splitBillEnabled     Boolean       @default(false)
  splitBillPaidUserIds String[]      @default([])
  snapshot             Json? // TourPackage snapshot at booking time (lightweight v1 versioning)
  metadata             Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  reviews Review[]

  @@index([tourPackageId, status])
  @@index([buyerUserId])
  @@index([tourDate, status])
  @@map("tour_bookings")
}

model Itinerary {
  id        String   @id @default(uuid())
  items     Json // [{ hour: int, title: string, description: string, location?: string, datetime: ISO }]
  notes     String?
  pdfUrl    String? // populated by 09-07 when SendGrid PDF attachment is generated
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking TourBooking?

  @@map("itineraries")
}

model Review {
  id            String           @id @default(uuid())
  targetType    ReviewTargetType
  targetId      String // foreign id pointed to by targetType (no FK — polymorphic)
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  tourBookingId String? // nullable so future modules can write reviews not tied to a tour
  tourBooking   TourBooking?     @relation(fields: [tourBookingId], references: [id])
  rating        Int // 1-5
  comment       String?
  photos        String[]
  flagged       Boolean          @default(false) // auto-set when rating <= 2
  metadata      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  flag AdminReviewFlag?

  @@index([targetType, targetId])
  @@index([userId])
  @@index([flagged])
  @@map("reviews")
}

model AdminReviewFlag {
  id         String    @id @default(uuid())
  reviewId   String    @unique
  review     Review    @relation(fields: [reviewId], references: [id])
  status     String    @default("OPEN") // OPEN | IN_REVIEW | RESOLVED | DISMISSED
  assignedTo String? // LGA_ADMIN userId
  resolution String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@map("admin_review_flags")
}

model SettlementDispute {
  id                     String    @id @default(uuid())
  settlementReference    String // the original Transaction.reference prefix this dispute targets
  module                 String // 'transport' | 'delivery' | 'events' | 'marketplace' | 'stays' | 'studio' | 'tour'
  raisedByUserId         String
  raisedBy               User      @relation(fields: [raisedByUserId], references: [id])
  reason                 String
  status                 String    @default("OPEN") // OPEN | IN_REVIEW | RESOLVED | DISMISSED | BLOCKED
  requestedAdjustmentNgn Decimal?
  assignedTo             String? // SUPER_ADMIN userId (D-02: no STATE_ADMIN this phase)
  resolution             String?
  resolvedAt             DateTime?
  adjustmentReference    String? // set once resolved+applied — the `${originalReference}-ADJ-*` prefix actually written
  metadata               Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // No @@unique([settlementReference]) here — a settlementReference
  // legitimately repeats across historical (RESOLVED/DISMISSED) rows once a
  // prior dispute against the same settlement has terminated. Uniqueness is
  // enforced only among ACTIVE statuses (OPEN/IN_REVIEW/BLOCKED) via a
  // partial index added by raw SQL in the migration (Postgres/Prisma can't
  // express a partial unique index as an `@@unique` schema attribute) —
  // mirrors SettlementSplitTier's `settlement_split_tiers_module_tierName_active_key`
  // pattern. See migration 20260720040000_settlement_dispute_partial_unique_active
  // (`settlement_disputes_active_per_reference`).
  @@index([status])
  @@index([settlementReference])
  @@map("settlement_disputes")
}
