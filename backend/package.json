{
  "name": "@iseyaa/backend",
  "version": "1.0.0",
  "description": "ISEYAA NestJS Backend",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main",
    "start:prod": "node --require ./dist/instrumentation.js dist/main.js",
    "start:prod:notifications-service": "node --require ./dist/instrumentation.js dist/apps/notifications-service/src/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset",
    "test:e2e:tours": "jest --config test/jest-e2e.json --testPathPattern=\"wallet-invariant|kyc-encryption|e2e-tour-booking\"",
    "test:e2e:settlement-splits": "jest --config test/jest-e2e.json --testPathPattern=\"e2e-settlement-split-tier-audit-trail\"",
    "test:e2e:settlement-disputes": "jest --config test/jest-e2e.json --testPathPattern=\"settlement-disputes.e2e\"",
    "build:services": "for s in auth-service wallet-service events-service stays-service marketplace-service admin-service ai-service notifications-service news-service waitlist-service reviews-service delivery-otp-service; do npx nest build $s || exit 1; done"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.1",
    "@iseyaa/proto": "0.1.0",
    "@nestjs/common": "^11.1.20",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.20",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^11.1.19",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^11.1.20",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.19",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@prisma/client": "^5.22.0",
    "@sentry/nestjs": "^10.52.0",
    "@upstash/vector": "^1.2.3",
    "axios": "^1.6.7",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cockatiel": "^3.2.1",
    "compression": "^1.7.4",
    "fast-csv": "^5.0.7",
    "google-auth-library": "^10.7.0",
    "grpc-health-check": "^2.1.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "kafkajs": "^2.2.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.1",
    "resend": "^6.18.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "ts-proto": "^2.11.8",
    "typesense": "^3.0.6",
    "uuid": "^9.0.1"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.20",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.11.20",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prisma": "^5.11.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "yn": "^3.1.1"
  }
}
