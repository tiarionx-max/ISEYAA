{
  "name": "iseyaa",
  "version": "1.0.0",
  "private": true,
  "description": "ISEYAA — Ogun State Digital Super-Platform",
  "workspaces": ["backend", "web", "mobile", "shared", "packages/proto"],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:web": "npm run dev --workspace=web",
    "build:all": "npm run build --workspaces --if-present",
    "lint:all": "npm run lint --workspaces --if-present",
    "test:all": "npm run test --workspaces --if-present",
    "prisma:migrate": "npm run prisma:migrate --workspace=backend",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "prisma:studio": "npm run prisma:studio --workspace=backend"
  },
  "engines": { "node": ">=20.0.0", "npm": ">=10.0.0" },
  "devDependencies": {
    "expo": "~51.0.0",
    "expo-router": "~3.5.0",
    "rxjs": "^7.8.1"
  },
  "overrides": {
    "expo": "~51.0.0",
    "expo-router": "~3.5.0",
    "expo-linking": "~6.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.1",
    "metro": "~0.80.9",
    "metro-config": "~0.80.9",
    "metro-core": "~0.80.9",
    "metro-runtime": "~0.80.9",
    "metro-source-map": "~0.80.9",
    "metro-transform-worker": "~0.80.9"
  }
}
