# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
.next/
out/
backend/dist/
backend/apps/*/src/**/*.js
backend/apps/*/src/**/*.js.map

# packages/proto compiled output (tsc compile-in-place; *.ts sources stay tracked,
# regenerate via `npm run build --workspace=packages/proto`)
packages/proto/generated/*.js
packages/proto/generated/*.d.ts

# Environment files — secrets must go in Infisical, never committed
.env
.env.*
!.env.example

# Service-account / credentials — never commit
firebase.json
*service-account*.json
*-credentials.json
google-service-account.json
*firebase-adminsdk*.json

# Logs
logs/
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Testing
coverage/

# Prisma
backend/prisma/*.db

# Shadow settlement verification reports (generated at runtime, per-run)
backend/shadow-report-*.json

# TypeScript incremental build cache
*.tsbuildinfo

# Expo
mobile/.expo/
# Turbo
.turbo/

# Claude agent worktrees (ephemeral, may contain build caches with long paths)
.claude/worktrees/

# Cloudflare Wrangler local dev state
.wrangler/
