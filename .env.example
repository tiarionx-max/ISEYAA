# ─── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://iseyaa:iseyaa_dev_password@localhost:5432/iseyaa_dev

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_at_least_32_chars_long_jwt_secret
JWT_REFRESH_SECRET=change_me_at_least_32_chars_long_refresh_secret

# ─── Payments — Paystack (primary) ─────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Payments — Flutterwave (fallback) ─────────────────────────────────────────
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# ─── Messaging ─────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@iseyaa.gov.ng
TERMII_API_KEY=TLxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TERMII_SENDER_ID=ISEYAA

# ─── Maps ──────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Cloudflare R2 (replaces AWS S3 + CloudFront — zero egress fees) ───────────
CF_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET=iseyaa-media
R2_PUBLIC_URL=

# ─── Typesense Search ───────────────────────────────────────────────────────────
TYPESENSE_HOST=localhost
TYPESENSE_API_KEY=your-typesense-api-key-change-me
TYPESENSE_PROTOCOL=http
TYPESENSE_PORT=8108

# ─── Firebase Push Notifications ───────────────────────────────────────────────
FIREBASE_SERVER_KEY=AAAAxxxxxxxx:APA91bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── gRPC Microservices (Wave 3) ────────────────────────────────────────────────
AUTH_SERVICE_URL=auth-service.railway.internal:5001
WALLET_SERVICE_URL=wallet-service.railway.internal:5002
EVENTS_SERVICE_URL=events-service.railway.internal:5003
STAYS_SERVICE_URL=stays-service.railway.internal:5004
MARKETPLACE_SERVICE_URL=marketplace-service.railway.internal:5005
ADMIN_SERVICE_URL=admin-service.railway.internal:5006
AI_SERVICE_URL=ai-service.railway.internal:5007
NOTIFICATIONS_SERVICE_URL=notifications-service.railway.internal:5008

# ─── Observability ──────────────────────────────────────────────────────────────
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o0.ingest.sentry.io/0
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
GRAFANA_CLOUD_OTLP_TOKEN=base64encodedbasicauthtoken
OTEL_SERVICE_NAME=iseyaa-api
